# Plantilla del .env de desarrollo. `composer setup` la copia a .env.
APP_NAME="LMS UES"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/El_Salvador

LOG_CHANNEL=stack
LOG_STACK=single

# Migraciones adaptativas (ADR-033): SQLite por defecto.
# Para PostgreSQL (citext, CHECK, EXCLUDE, triggers de auditoría, RLS, particiones):
# comente DB_CONNECTION=sqlite y descomente el bloque pgsql.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=lms
# DB_USERNAME=lms
# DB_PASSWORD=lms

SESSION_DRIVER=database
SESSION_LIFETIME=30

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

# predis (cliente en PHP) en vez de la extensión phpredis: funciona igual en Linux y Windows
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="lms@ues.edu.sv"
MAIL_FROM_NAME="${APP_NAME}"

# Archivos subidos en storage/app/private. MinIO/S3 queda para cuando se decida el almacenamiento (ADR-020).
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=lms
AWS_SECRET_ACCESS_KEY=lms-secret-dev
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=lms-archivos
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

REVERB_APP_ID=lms-local
REVERB_APP_KEY=lms-local-key
REVERB_APP_SECRET=lms-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Inicio de sesión con Google (RF01, ADR-007). Cliente OAuth «Aplicación web» del proyecto de Google Cloud
# de la UES (lo tramita TI). URI de redirección autorizada: ${APP_URL}/auth/google/callback.
# Nunca suba los valores reales al repositorio. Verifique con: php artisan google:verificar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_ALLOWED_DOMAIN=ues.edu.sv

# Google Calendar (RF21, ADR-018): mismo cliente OAuth, con la Calendar API habilitada y la URI de redirección
# ${APP_URL}/perfil/google-calendar/callback autorizada. Pruebe con: php artisan google:calendar-prueba <correo>
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_REDIRECT_URI="${APP_URL}/perfil/google-calendar/callback"

# Inicio de sesión de desarrollo (elige un usuario sembrado por rol). Nunca en producción.
LMS_DEV_LOGIN=true
# Área de asistencia que siembran los seeders (RF20): por defecto el campus FMO. Para probar el QR
# desde otro lugar, ponga sus coordenadas aquí y vuelva a sembrar.
# LMS_AREA_LAT=13.4393
# LMS_AREA_LNG=-88.1597
# LMS_AREA_RADIO=450
