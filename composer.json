{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "chillerlan/php-qrcode": "^6.0",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.50",
        "laravel/reverb": "^1.12",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^2.10.1",
        "livewire/livewire": "^4.0",
        "maennchen/zipstream-php": "^3.2",
        "mews/purifier": "^3.4",
        "openspout/openspout": "^4.28",
        "predis/predis": "^3.7",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate:fresh --seed --ansi",
            "bun install",
            "bun run build",
            "@php artisan boost:update --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -k -c \"#93c5fd,#c4b5fd,#fdba74,#86efac,#fb7185,#fde047\" \"php artisan serve\" \"php artisan horizon\" \"php artisan reverb:start --debug\" \"php artisan schedule:work\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=web,horizon,reverb,schedule,logs,vite"
        ],
        "dev:win": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -k -c \"#93c5fd,#c4b5fd,#fdba74,#86efac,#fde047\" \"php artisan serve\" \"php artisan queue:listen redis --queue=notificaciones,default,google,importaciones,reportes --tries=3\" \"php artisan reverb:start --debug\" \"php artisan schedule:work\" \"bun run dev\" --names=web,queue,reverb,schedule,vite"
        ],
        "fresh": [
            "@php artisan migrate:fresh --seed --ansi"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "vendor/bin/pest --parallel"
        ],
        "test:browser": [
            "Composer\\Config::disableProcessTimeout",
            "@php scripts/navegador.php"
        ],
        "check": [
            "vendor/bin/pint --test",
            "vendor/bin/phpstan analyse --level=5 --memory-limit=1G",
            "vendor/bin/pest --parallel --coverage --min=70"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.4.27"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
