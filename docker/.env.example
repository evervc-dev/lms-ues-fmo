# Copie a docker/.env para correr la pila localmente. En Coolify, estas van en «Environment Variables».
APP_URL=http://localhost:8088
# php artisan key:generate --show
APP_KEY=
DB_PASSWORD=
REVERB_APP_SECRET=
# Demo (staging): siembra los datos de prueba y activa «Entrar como…»
LMS_DEMO_SEED=true
LMS_DEV_LOGIN=true
# Perfil de siembra: demo (personas inventadas) o equipo (solo las cuentas reales del equipo).
LMS_SEED_PERFIL=demo
LMS_SEED_SEMILLA=2026
# Superadmin (ADR-082): póngale una contraseña larga solo aquí o en Coolify, nunca en el repositorio.
SUPERADMIN_EMAIL=superadmin@ues.edu.sv
SUPERADMIN_PASSWORD=
# Pruebas en staging (se ignoran en producción).
LMS_ROLES_LAXOS=false
ASIS_BYPASS_WEEKEND=false
